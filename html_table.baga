// html_table.baga — extract first <table> from well-formed XHTML into CsvTable.
// Accounting report path: HTML preview → rows → Excel.

import "xmlbaga/xml.baga"
import "csvbaga/csv.baga"
import "bufbaga/buf.baga"
import "std/str/str.baga"

fn html_local(name: str) -> str {
    let n = len(name)
    let mut i = n - 1
    while i >= 0 {
        if char_at(name, i) == 58 {
            return substr(name, i + 1, n)
        }
        if i == 0 {
            return name
        }
        i = i - 1
    }
    return name
}

// Flatten first table to TSV-like rows (tab cells), then csv_from_tsv.
// Ignores nested tables (depth table==1 only).
fn html_first_table_tsv(html: str) -> str {
    let p = xml_parser(html)
    let mut b = buf_new()
    let mut in_table: i64 = 0
    let mut in_cell: i64 = 0
    let mut cell_first: i64 = 1
    let mut row_has: i64 = 0
    let mut done: i64 = 0
    let mut cell_buf = buf_new()
    while done == 0 {
        let ev = xml_next(p)
        if ev.kind == 0 || ev.kind == 0 - 1 {
            done = 1
        } else {
            if ev.kind == 1 {
                let loc = html_local(ev.name)
                if loc == "table" {
                    in_table = in_table + 1
                }
                if in_table == 1 {
                    if loc == "tr" {
                        cell_first = 1
                        row_has = 0
                    }
                    if loc == "td" || loc == "th" {
                        in_cell = 1
                        cell_buf = buf_clear(cell_buf)
                        if cell_first == 0 {
                            b = buf_push(b, "\t")
                        }
                        cell_first = 0
                        row_has = 1
                    }
                    if loc == "br" && in_cell == 1 {
                        cell_buf = buf_push(cell_buf, " ")
                    }
                }
            } else {
                if ev.kind == 2 {
                    let loc = html_local(ev.name)
                    if in_table == 1 {
                        if loc == "td" || loc == "th" {
                            b = buf_push(b, str_trim(buf_str(cell_buf)))
                            in_cell = 0
                        }
                        if loc == "tr" {
                            if row_has == 1 {
                                b = buf_push(b, "\n")
                            }
                        }
                    }
                    if loc == "table" {
                        in_table = in_table - 1
                        if in_table == 0 {
                            done = 1
                        }
                    }
                } else {
                    if ev.kind == 3 {
                        if in_cell == 1 && in_table == 1 {
                            cell_buf = buf_push(cell_buf, ev.text)
                        }
                    }
                }
            }
        }
    }
    return buf_str(b)
}

fn html_table_to_csv(html: str) -> CsvTable {
    let tsv = html_first_table_tsv(html)
    if str_trim(tsv) == "" {
        return csv_fail("html: no table cells found")
    }
    return csv_from_tsv(tsv)
}

// Title: first <h1> text, else "".
fn html_report_title(html: str) -> str {
    let p = xml_parser(html)
    let mut in_h1: i64 = 0
    let mut b = buf_new()
    let mut done: i64 = 0
    while done == 0 {
        let ev = xml_next(p)
        if ev.kind == 0 || ev.kind == 0 - 1 {
            done = 1
        } else {
            if ev.kind == 1 {
                if html_local(ev.name) == "h1" {
                    in_h1 = 1
                    b = buf_clear(b)
                }
            } else {
                if ev.kind == 2 {
                    if html_local(ev.name) == "h1" {
                        done = 1
                    }
                } else {
                    if ev.kind == 3 {
                        if in_h1 == 1 {
                            b = buf_push(b, ev.text)
                        }
                    }
                }
            }
        }
    }
    return str_trim(buf_str(b))
}

// All <p> text after title until the first table (joined with " · ").
fn html_report_meta(html: str) -> str {
    let p = xml_parser(html)
    let mut in_p: i64 = 0
    let mut seen_h1: i64 = 0
    let mut out = buf_new()
    let mut cur = buf_new()
    let mut npara: i64 = 0
    let mut done: i64 = 0
    while done == 0 {
        let ev = xml_next(p)
        if ev.kind == 0 || ev.kind == 0 - 1 {
            done = 1
        } else {
            if ev.kind == 1 {
                let loc = html_local(ev.name)
                if loc == "h1" {
                    seen_h1 = 1
                }
                if loc == "table" && seen_h1 == 1 {
                    done = 1
                }
                if loc == "p" && seen_h1 == 1 && done == 0 {
                    in_p = 1
                    cur = buf_clear(cur)
                }
            } else {
                if ev.kind == 2 {
                    if html_local(ev.name) == "p" && in_p == 1 {
                        let t = str_trim(buf_str(cur))
                        if t != "" {
                            if npara > 0 {
                                out = buf_push(out, " · ")
                            }
                            out = buf_push(out, t)
                            npara = npara + 1
                        }
                        in_p = 0
                    }
                } else {
                    if ev.kind == 3 {
                        if in_p == 1 {
                            cur = buf_push(cur, ev.text)
                        }
                    }
                }
            }
        }
    }
    return str_trim(buf_str(out))
}

// Escape for HTML cell text.
fn html_esc_cell(s: str) -> str {
    let mut out = ""
    let mut i: i64 = 0
    while i < len(s) {
        let c = char_at(s, i)
        if c == 38 {
            out = concat(out, "&amp;")
        } else {
            if c == 60 {
                out = concat(out, "&lt;")
            } else {
                if c == 62 {
                    out = concat(out, "&gt;")
                } else {
                    if c == 34 {
                        out = concat(out, "&quot;")
                    } else {
                        out = concat(out, chr(c))
                    }
                }
            }
        }
        i = i + 1
    }
    return out
}

// R4 (closed 2026-10-31): number formatting — BGN с 2 десетични и разделител
// за хиляди (nbsp). Разпознава се по числов низ (опц. знак, цифри, опц. точка).
fn report_is_number(s: str) -> i64 {
    let t = str_trim(s)
    let n = len(t)
    if n == 0 {
        return 0
    }
    let mut i: i64 = 0
    if char_at(t, 0) == 45 || char_at(t, 0) == 43 {
        i = 1
    }
    let mut digits: i64 = 0
    let mut dots: i64 = 0
    while i < n {
        let c = char_at(t, i)
        if c >= 48 && c <= 57 {
            digits = digits + 1
        } else if c == 46 {
            dots = dots + 1
            if dots > 1 {
                return 0
            }
        } else {
            return 0
        }
        i = i + 1
    }
    if digits == 0 {
        return 0
    }
    return 1
}

// Форматира числов низ като BGN: 1234567.8 → "1 234 567,80". Нечислови — непроменени.
fn report_fmt_bgn(s: str) -> str {
    let t = str_trim(s)
    if report_is_number(t) == 0 {
        return s
    }
    let mut neg: i64 = 0
    let mut i: i64 = 0
    if char_at(t, 0) == 45 {
        neg = 1
        i = 1
    } else if char_at(t, 0) == 43 {
        i = 1
    }
    let rest = substr(t, i, len(t))
    let dot = str_find(rest, ".")
    let mut int_part = rest
    let mut frac_part = ""
    if dot >= 0 {
        int_part = substr(rest, 0, dot)
        frac_part = substr(rest, dot + 1, len(rest))
    }
    let mut k: i64 = 0
    while k < len(int_part) - 1 && char_at(int_part, k) == 48 {
        k = k + 1
    }
    let ip = substr(int_part, k, len(int_part))
    let mut grouped = ""
    let il = len(ip)
    let mut j: i64 = 0
    while j < il {
        if j > 0 && (il - j) % 3 == 0 {
            grouped = concat(grouped, byte_chr(160))
        }
        grouped = concat(grouped, byte_chr(char_at(ip, j)))
        j = j + 1
    }
    let mut frac = frac_part
    if len(frac) > 2 {
        frac = substr(frac, 0, 2)
    }
    while len(frac) < 2 {
        frac = concat(frac, "0")
    }
    let mut out = concat(concat(grouped, ","), frac)
    if neg == 1 {
        out = concat("-", out)
    }
    return out
}

// R4: table → HTML с number formatting за числови клетки (редове след header).
fn report_table_to_html_fmt(t: CsvTable) -> str {
    if t.ok == 0 || t.cols <= 0 {
        return ""
    }
    let nr = csv_nrows(t)
    let mut b = buf_new()
    b = buf_push(b, "<table>\n")
    let mut r: i64 = 0
    while r < nr {
        if r == 0 {
            b = buf_push(b, "<thead><tr>")
        } else if r == 1 {
            b = buf_push(b, "</thead><tbody>\n<tr>")
        } else {
            b = buf_push(b, "<tr>")
        }
        let mut c: i64 = 0
        while c < t.cols {
            let cell = csv_get(t, r, c)
            if r == 0 {
                b = buf_push(b, concat("<th>", concat(html_esc_cell(cell), "</th>")))
            } else {
                b = buf_push(b, concat("<td>", concat(html_esc_cell(report_fmt_bgn(cell)), "</td>")))
            }
            c = c + 1
        }
        if r == 0 {
            b = buf_push(b, "</tr></thead>\n")
        } else {
            b = buf_push(b, "</tr>\n")
        }
        r = r + 1
    }
    b = buf_push(b, "</tbody>\n</table>\n")
    return buf_str(b)
}

// CsvTable → HTML <table> fragment (first row = thead).
fn report_table_to_html(t: CsvTable) -> str {
    if t.ok == 0 || t.cols <= 0 {
        return ""
    }
    let nr = csv_nrows(t)
    let mut b = buf_new()
    b = buf_push(b, "<table>\n")
    let mut r: i64 = 0
    while r < nr {
        if r == 0 {
            b = buf_push(b, "<thead><tr>")
        } else {
            if r == 1 {
                b = buf_push(b, "</thead><tbody>\n<tr>")
            } else {
                b = buf_push(b, "<tr>")
            }
        }
        let mut c: i64 = 0
        while c < t.cols {
            if r == 0 {
                b = buf_push(b, "<th>")
                b = buf_push(b, html_esc_cell(csv_get(t, r, c)))
                b = buf_push(b, "</th>")
            } else {
                b = buf_push(b, "<td>")
                b = buf_push(b, html_esc_cell(csv_get(t, r, c)))
                b = buf_push(b, "</td>")
            }
            c = c + 1
        }
        b = buf_push(b, "</tr>\n")
        r = r + 1
    }
    if nr > 1 {
        b = buf_push(b, "</tbody>\n")
    } else {
        if nr == 1 {
            b = buf_push(b, "</thead>\n")
        }
    }
    b = buf_push(b, "</table>")
    return buf_str(b)
}

// Full XHTML document for browser preview.
fn report_ir_to_html(title: str, meta: str, t: CsvTable) -> str {
    let mut b = buf_new()
    b = buf_push(b, "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n")
    b = buf_push(b, "<html xmlns=\"http://www.w3.org/1999/xhtml\"><head><meta charset=\"utf-8\"/>")
    b = buf_push(b, "<title>")
    b = buf_push(b, html_esc_cell(title))
    b = buf_push(b, "</title><style type=\"text/css\">body{font-family:DejaVu Sans,sans-serif;font-size:13px;margin:24px}h1{font-size:18px;margin:0 0 8px}p{margin:0 0 12px;color:#333}table{border-collapse:collapse;width:100%}th,td{border:1px solid #444;padding:5px 8px;text-align:left;vertical-align:top}th{background:#e8e8e8}</style>")
    b = buf_push(b, "</head><body>\n")
    b = buf_push(b, "<h1>")
    b = buf_push(b, html_esc_cell(title))
    b = buf_push(b, "</h1>\n")
    if meta != "" {
        b = buf_push(b, "<p>")
        b = buf_push(b, html_esc_cell(meta))
        b = buf_push(b, "</p>\n")
    }
    b = buf_push(b, report_table_to_html(t))
    b = buf_push(b, "\n</body></html>\n")
    return buf_str(b)
}

fn HTML_H1() -> i64 { return 1 }
fn HTML_P() -> i64 { return 2 }
fn HTML_TABLE() -> i64 { return 3 }

struct HtmlDoc {
    kinds: Vec<i64>,
    texts: Vec<str>,
    ok: i64,
    err: str
}

fn html_doc_fail(msg: str) -> HtmlDoc {
    return HtmlDoc { kinds: vec_new(), texts: vec_new(), ok: 0, err: msg }
}

fn html_doc_parse(html: str) -> HtmlDoc {
    let p = xml_parser(html)
    let kinds: Vec<i64> = vec_new()
    let texts: Vec<str> = vec_new()
    let mut in_table: i64 = 0
    let mut in_cell: i64 = 0
    let mut in_h1: i64 = 0
    let mut in_p: i64 = 0
    let mut cell_first: i64 = 1
    let mut row_has: i64 = 0
    let mut tsv = buf_new()
    let mut cell_buf = buf_new()
    let mut text_buf = buf_new()
    let mut done: i64 = 0
    while done == 0 {
        let ev = xml_next(p)
        if ev.kind == 0 || ev.kind == 0 - 1 {
            done = 1
        } else {
            if ev.kind == 1 {
                let loc = html_local(ev.name)
                if loc == "table" {
                    in_table = in_table + 1
                    if in_table == 1 {
                        tsv = buf_clear(tsv)
                    }
                }
                if in_table == 1 {
                    if loc == "tr" {
                        cell_first = 1
                        row_has = 0
                    }
                    if loc == "td" || loc == "th" {
                        in_cell = 1
                        cell_buf = buf_clear(cell_buf)
                        if cell_first == 0 {
                            tsv = buf_push(tsv, "\t")
                        }
                        cell_first = 0
                        row_has = 1
                    }
                    if loc == "br" && in_cell == 1 {
                        cell_buf = buf_push(cell_buf, " ")
                    }
                } else {
                    if loc == "h1" {
                        in_h1 = 1
                        text_buf = buf_clear(text_buf)
                    }
                    if loc == "p" {
                        in_p = 1
                        text_buf = buf_clear(text_buf)
                    }
                    if loc == "br" && in_p == 1 {
                        text_buf = buf_push(text_buf, " ")
                    }
                }
            } else {
                if ev.kind == 2 {
                    let loc = html_local(ev.name)
                    if in_table >= 1 {
                        if in_table == 1 {
                            if loc == "td" || loc == "th" {
                                tsv = buf_push(tsv, str_trim(buf_str(cell_buf)))
                                in_cell = 0
                            }
                            if loc == "tr" {
                                if row_has == 1 {
                                    tsv = buf_push(tsv, "\n")
                                }
                            }
                        }
                        if loc == "table" {
                            in_table = in_table - 1
                            if in_table == 0 {
                                vec_push(kinds, HTML_TABLE())
                                vec_push(texts, buf_str(tsv))
                            }
                        }
                    } else {
                        if loc == "h1" && in_h1 == 1 {
                            let t = str_trim(buf_str(text_buf))
                            if t != "" {
                                vec_push(kinds, HTML_H1())
                                vec_push(texts, t)
                            }
                            in_h1 = 0
                        }
                        if loc == "p" && in_p == 1 {
                            let t = str_trim(buf_str(text_buf))
                            if t != "" {
                                vec_push(kinds, HTML_P())
                                vec_push(texts, t)
                            }
                            in_p = 0
                        }
                    }
                } else {
                    if ev.kind == 3 {
                        if in_table == 1 && in_cell == 1 {
                            cell_buf = buf_push(cell_buf, ev.text)
                        } else {
                            if in_h1 == 1 || in_p == 1 {
                                text_buf = buf_push(text_buf, ev.text)
                            }
                        }
                    }
                }
            }
        }
    }
    if vec_len(kinds) < 1 {
        return html_doc_fail("html: no document blocks")
    }
    return HtmlDoc { kinds: kinds, texts: texts, ok: 1, err: "" }
}

